# Copy to .env (never commit .env)
DATABASE_URL=sqlite:///./queueflow.db
# Production: random string >= 32 chars (dev default is short; PyJWT warns below 32).
# With ENV=prod the server REFUSES to boot on the default/short key.
SECRET_KEY=change-me-in-env
# CORS origins for browser API calls. Dev default is "*" (file:// iteration);
# with ENV=prod this list is enforced and empty means refuse-to-boot.
# CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Optional overrides (defaults shown):
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=720
# S4 video uploads (defaults shown):
# UPLOAD_DIR=data/uploads
# MAX_VIDEO_MB=50
# Queue-image uploads (defaults shown):
# MAX_IMAGE_MB=10
# Google Sign-In (public client ID; already defaulted in config):
# GOOGLE_CLIENT_ID=650223765036-q2s9vdbg607mett9ld348plp46s36p54.apps.googleusercontent.com
ENV=dev
